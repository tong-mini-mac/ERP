# Universal ERP Demo — Environment Configuration
# This repo is ERP-Demo only. Do NOT point these values at company ATLAS.

# Application
ENVIRONMENT=demo
PRODUCT_MODE=erp-demo
# Must remain false — demo must not verify IN Z / ATLAS SSO handoffs
ACCEPT_INZ_SSO=false
DEBUG=true

# Demo API is in-memory; DATABASE_URL is unused by the sandbox server.
# Keep it only if you later wire optional persistence for demo experiments.
DATABASE_URL=postgresql+psycopg://erp_demo:erp_demo@localhost:5432/erp_demo
REDIS_URL=redis://localhost:6379/1

# Module databases (optional / unused by current sandbox server)
ERP_HR_DATABASE_PATH=data/hr.db
PROCUREMENT_V2_DATABASE_URL=sqlite:///./data/procurement.db
FINANCE_AUDIT_DB_PATH=data/finance_audit.db
FINANCE_COUNTRY_CODE=TH

# Auth — use a secret that is NEVER shared with production ATLAS
JWT_SECRET=erp-demo-only-secret-min-32-characters
JWT_ACCESS_EXPIRE_MINUTES=60

# Athena CFO Brain (optional — enables /api/cfo/* endpoints)
ATHENA_MACRO_REFRESH_ON_START=0
GEMINI_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=your-local-model

# Procurement LLM (optional)
PROCUREMENT_V21_ENABLE_LLM=false
OPENAI_API_KEY=

# Marketing LLM (optional — also powers /api/marketing/legs/resto/*)
# RESTO_HITL_POST_APPROVAL_TYPES=complaint,refund_request,food_safety,review_bomb_risk
# Resto marketing leg: erp/modules/marketing/legs/resto/ (same deploy as ERP)

# Google Cloud Vision — document OCR (invoice, TOR, contract)
GCP_VISION_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
# Path to service account JSON with Cloud Vision API enabled
# DOCUMENT_MAX_UPLOAD_BYTES=15728640

# Azure Document Intelligence — smart OCR routing (optional; GCP fallback)
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Billing (Stripe — auto-sync plan_tier via webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy price IDs (map to Micro / Small)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Platform tier price IDs (create in Stripe Dashboard)
STRIPE_PRICE_SOLO=
STRIPE_PRICE_MICRO=
STRIPE_PRICE_SMALL=
STRIPE_PRICE_MEDIUM=
STRIPE_PRICE_LARGE=
BILLING_SUCCESS_URL=http://localhost:5173/billing/success
BILLING_CANCEL_URL=http://localhost:5173/billing/cancel
BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Monolith deploy (Railway) — serve Vite build from FastAPI
# SERVE_FRONTEND=true
# FRONTEND_DIST_DIR=/app/static/dist

# Vertical data feeds — MOC/BOT open data + ERP KPIs (weekly Monday batch)
# BOT_API_TOKEN=                    # from https://apiportal.bot.or.th/ — skip BOT feeds if unset
# BOT_API_BASE_URL=https://gateway.api.bot.or.th
# MOC_API_BASE_URL=https://dataapi.moc.go.th
# VERTICAL_FEED_ENABLED=true
# VERTICAL_FEED_FORCE=false         # true = run every day (dev)

# Hybrid LLM — DeepSeek draft + GPT customer summary
# DEEPSEEK_API_KEY=                 # https://platform.deepseek.com/
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=                   # GPT polish for customer-facing output
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# ANALYTICS_SUMMARY_MODEL=gpt-4o-mini
# ANALYTICS_HYBRID_ENABLED=true
# COMMUNICATOR_LLM_PROVIDER=deepseek
# SAG_DRAFT_PROVIDER=deepseek
# SAG_SUMMARY_PROVIDER=openai

# Beta feedback — external form + Zendesk tickets
# EXTERNAL_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM/viewform
# ZENDESK_ENABLED=false
# ZENDESK_SUBDOMAIN=your-subdomain
# ZENDESK_EMAIL=agent@yourcompany.com
# ZENDESK_API_TOKEN=

# Product analytics (Mixpanel) — also set VITE_MIXPANEL_TOKEN in frontend/.env
# MIXPANEL_TOKEN=

# Legal versions (shown in /legal/* and public-config)
# PRIVACY_POLICY_VERSION=2026-06-16
# TERMS_VERSION=2026-06-16
