# Copy to .env and fill in keys. Used by: python -m athena train-agents --llm
# (loaded with override so these win over Centralize/.env for the same variable names)

# Google AI (legacy — optional fallback)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Hybrid CFO: DeepSeek draft + GPT customer summary (default)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# ANALYTICS_SUMMARY_MODEL=gpt-4o-mini
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# COMMUNICATOR_LLM_PROVIDER=deepseek
# SAG_DRAFT_PROVIDER=deepseek
# SAG_SUMMARY_PROVIDER=openai

# Chat scripts (paraphrase_100_cfo_benchmark): auto uses Gemini when GEMINI_API_KEY is set
# ATHENA_CHAT_PROVIDER=auto

# OpenAI (train-agents --llm, or Communicator fallback)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Embeddings (scripts/chunk_embed_ingest.py)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Raw intake autoprocess on startup (Athena / python -m athena): chunk intake/*.txt → chunks/, move to Old Data/
# ATHENA_RAW_DATA_AUTOPREP_ON_START=1
# ATHENA_RAW_CHUNK_MAX_KB=512

# CFO grounded benchmark (scripts/paraphrase_100_cfo_benchmark.py)
# ATHENA_CFO_SYSTEM_PROMPT_PATH=D:\Myworkspace\Athena\config\cfo_grounded_system_prompt.txt
# ATHENA_BENCH_LIMIT=100
# CFO benchmark: shrink attached files to avoid Gemini 429 TPM (default ~6000 chars/file)
# ATHENA_CFO_BUNDLE_MAX_CHARS_PER_FILE=6000
# ATHENA_CFO_INTER_REQUEST_SLEEP_SEC=0.85
# ATHENA_CFO_BUNDLE_FULL=1

# Force provider: auto | gemini | openai
# Use OpenAI-compatible local (LM Studio) for Communicator:
# COMMUNICATOR_LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=deepseek-r1-distill-qwen-14b
# OPENAI_API_KEY=lm-studio

# --- Macro data (World Bank, FRED, IMF, OECD, …) ---
# When 1 (default): first ``Athena()`` / ``get_athena()`` runs ``macro-daily`` under vendor/centralize
# ATHENA_MACRO_REFRESH_ON_START=1
# Force full refresh every time (heavy on APIs): ATHENA_MACRO_DAILY_FORCE=1
# Limit sources: ATHENA_MACRO_ONLY=fred,world_bank
# Log: data/macro_refresh_bootstrap.log
