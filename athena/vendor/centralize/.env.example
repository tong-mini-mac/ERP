# Copy this file to `.env` in the project root (same folder as pyproject.toml).
# python-dotenv loads it automatically when using FRED / optional LLM.
#
# FRED — free API key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without FRED_API_KEY, populate_macro_multisource skips FRED (WB + IMF still run).
FRED_API_KEY=

# IMF CompactData (no key). Timeout per request in seconds (default 30).
# IMF_HTTP_TIMEOUT=45
# If IMF host is blocked, fetch stops after the first failed area unless you set:
# IMF_CONTINUE_ON_NETWORK_ERROR=1
# (Put that line in your real `.env` file, or in PowerShell use:
#   $env:IMF_CONTINUE_ON_NETWORK_ERROR = "1"
# — the CMD-style `set VAR=1` does not set process env in PowerShell.)
# If direct HTTPS to dataservices.imf.org fails, route IMF via proxy (Clash, corp proxy):
# IMF_HTTPS_PROXY=http://127.0.0.1:7890
# (Standard HTTPS_PROXY / HTTP_PROXY are also used when IMF_HTTPS_PROXY is unset.)

# OWID COVID / OxCGRT stringency (optional). Disable large CSV pull:
# OWID_COVID_DISABLE=1
# Or override CSV URL if OWID moves the file (see owid_stringency.py).
# OWID_COVID_CSV_URL=

# OECD.Stat (CTS combined CIT) — public SDMX, no key (see oecd_client.py).
#
# Optional: Yahoo via yfinance (install: pip install -e ".[benchmarks]")
# - Equity benchmarks (S&P, etc.) + energy/logistics ETF proxies (BDRY, SEA, IYT). Crude: FRED WTI/Brent.

# Optional: Communicator — LLM narrative (auto = Gemini if GEMINI_API_KEY set, else OpenAI)
# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# COMMUNICATOR_LLM_PROVIDER=auto
#
# Optional: OpenAI instead / fallback
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# LM Studio / OpenAI-compatible local server (Chat Completions API):
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=deepseek-r1-distill-qwen-14b
# OPENAI_API_KEY=lm-studio
